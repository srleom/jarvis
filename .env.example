# ---------------------------------------------------------------------------
# orchestrator/.env
# ---------------------------------------------------------------------------
# Shared secret between Convex and the orchestrator. Generate with: openssl rand -hex 24
ORCHESTRATOR_SECRET=
# Convex deployment URL (same as web/.env.local NEXT_PUBLIC_CONVEX_URL)
CONVEX_URL=http://127.0.0.1:3210
# Stable public HTTPS URL of the orchestrator. Recall posts webhooks here and
# rejects localhost. Use a reserved ngrok domain in development. (ORCHESTRATOR_PUBLIC_URL is the old name.)
PUBLIC_API_BASE_URL=https://your-orchestrator.ngrok.app
# Public URL of the web app (Recall renders /bot/<meetingId> from here). Use ngrok in development.
BOT_PAGE_BASE_URL=https://your-web.ngrok.app
PORT=8787

# Backend only. Never put these in web/ or any client code.
RECALL_API_KEY=
RECALL_REGION=us-west-2
# Verifies every webhook and realtime request from Recall (starts with whsec_).
RECALL_WEBHOOK_VERIFICATION_SECRET=
# screenshare (default) or camera, if screenshare doesn't work in Meet
RECALL_OUTPUT_MODE=screenshare

ANTHROPIC_API_KEY=

CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
# Optional overrides
# CARTESIA_MODEL=sonic-3.6
# CARTESIA_VERSION=2026-08-14

MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

BRIGHT_DATA_API_KEY=
BRIGHT_DATA_SERP_ZONE=
BRIGHT_DATA_UNLOCKER_ZONE=

# Slack app: Socket Mode on. Bot scopes: chat:write, im:history, im:read, im:write, users:read. Event: message.im
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# ---------------------------------------------------------------------------
# web/.env.local (written by `npx convex dev`, plus:)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
# WebSocket URL of the orchestrator for the bot page's voice (wss://... when public)
# NEXT_PUBLIC_ORCHESTRATOR_WS_URL=ws://127.0.0.1:8787

# ---------------------------------------------------------------------------
# Convex deployment env (set with `npx convex env set NAME value` in web/)
# ---------------------------------------------------------------------------
# ORCHESTRATOR_URL=http://127.0.0.1:8787     (or the public orchestrator URL for a cloud deployment)
# ORCHESTRATOR_SECRET=<same as above>
# ANTHROPIC_API_KEY=                          (meeting notes)
# SLACK_BOT_TOKEN=                            (Team tab user list, posting notes)
